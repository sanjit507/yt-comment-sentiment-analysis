{
  "manifest_version": 3,
  "name": "YouTube Comment Analysis",
  "version": "1.0.0",
  "description": "Scan visible YouTube comments and send them to the local sentiment API.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Comment Analysis"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
