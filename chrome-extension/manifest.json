{
  "manifest_version": 3,
  "name": "YouTube Comment Sentiment Helper",
  "version": "1.0.0",
  "description": "Scrape visible YouTube comments and send them to the local Flask sentiment API.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Comment Sentiment Helper"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
